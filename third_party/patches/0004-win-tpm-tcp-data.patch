+/*
+ * swtpm --server speaks the same raw TPM command stream as the fd passed
+ * with CMD_SET_DATAFD. Windows has no SCM_RIGHTS, so that is the data path.
+ */
+static int tpm_emulator_prepare_data_tcp(TPMEmulator *tpm_emu)
+{
+    SocketAddress addr;
+    Error *err = NULL;
+    QIOChannelSocket *sioc;
+    g_autofree char *port = g_strdup_printf("%u", tpm_emu->data_port);
+
+    memset(&addr, 0, sizeof(addr));
+    addr.type = SOCKET_ADDRESS_TYPE_INET;
+    addr.u.inet.host = tpm_emu->data_host;
+    addr.u.inet.port = port;
+
+    sioc = qio_channel_socket_new();
+    if (qio_channel_socket_connect_sync(sioc, &addr, &err) < 0) {
+        error_reportf_err(err, "tpm-emulator: Cannot connect data channel to %s:%u: ",
+                          tpm_emu->data_host, tpm_emu->data_port);
+        object_unref(OBJECT(sioc));
+        return -1;
+    }
+
+    /*
+     * socket_connect() leaves the fd non-blocking. The command stream
+     * uses blocking qio_channel_read_all, same as the Unix socketpair.
+     */
+    if (!qemu_set_blocking(sioc->fd, true, &err)) {
+        error_report_err(err);
+        object_unref(OBJECT(sioc));
+        return -1;
+    }
+
+    tpm_emu->data_ioc = QIO_CHANNEL(sioc);
+    return 0;
+}
+
+static int tpm_emulator_probe_version_ioc(TPMEmulator *tpm_emu)
+{
+    const struct tpm_req_hdr test_req_tpm2 = {
+        .tag = cpu_to_be16(TPM2_ST_NO_SESSIONS),
+        .len = cpu_to_be32(sizeof(test_req_tpm2)),
+        .ordinal = cpu_to_be32(TPM2_CC_ReadClock),
+    };
+    const struct tpm_req_hdr test_req = {
+        .tag = cpu_to_be16(TPM_TAG_RQU_COMMAND),
+        .len = cpu_to_be32(sizeof(test_req)),
+        .ordinal = cpu_to_be32(TPM_ORD_GetTicks),
+    };
+    uint8_t buf[1024];
+    Error *err = NULL;
+
+    if (tpm_emulator_unix_tx_bufs(tpm_emu, (const uint8_t *)&test_req_tpm2,
+                                  sizeof(test_req_tpm2), buf, sizeof(buf),
+                                  NULL, &err) == 0 &&
+        tpm_cmd_get_tag(buf) == TPM2_ST_NO_SESSIONS) {
+        tpm_emu->tpm_version = TPM_VERSION_2_0;
+        return 0;
+    }
+    error_free(err);
+    err = NULL;
+
+    if (tpm_emulator_unix_tx_bufs(tpm_emu, (const uint8_t *)&test_req,
+                                  sizeof(test_req), buf, sizeof(buf),
+                                  NULL, &err) == 0 &&
+        tpm_cmd_get_tag(buf) == TPM_TAG_RSP_COMMAND) {
+        tpm_emu->tpm_version = TPM_VERSION_1_2;
+        return 0;
+    }
+    error_free(err);
+    tpm_emu->tpm_version = TPM_VERSION_UNSPEC;
+    return -1;
+}
+
