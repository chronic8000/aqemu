--- a/audio/sdlaudio.c
+++ b/audio/sdlaudio.c
@@ -158,7 +158,7 @@ static int sdl_to_audfmt(int sdlfmt, AudioFormat *fmt, bool *big_endian)
 }
 
 static SDL_AudioDeviceID sdl_open(SDL_AudioSpec *req, SDL_AudioSpec *obt,
-                                  int rec)
+                                  int rec, const char *devname)
 {
     SDL_AudioDeviceID devid;
 #ifndef _WIN32
@@ -178,7 +178,9 @@ static SDL_AudioDeviceID sdl_open(SDL_AudioSpec *req, SDL_AudioSpec *obt,
     }
 #endif
 
-    devid = SDL_OpenAudioDevice(NULL, rec, req, obt, 0);
