+        devname = NULL;
+    devid = SDL_OpenAudioDevice(devname, rec, req, obt, 0);
     if (!devid) {
         error_report("SDL_OpenAudioDevice for %s failed: %s",
                    rec ? "recording" : "playback", SDL_GetError());
@@ -345,7 +347,7 @@ static int sdl_init_out(HWVoiceOut *hw, struct audsettings *as)
