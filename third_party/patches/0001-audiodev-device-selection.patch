diff --git a/audio/dsoundaudio.c b/audio/dsoundaudio.c
index 338ee49c2f..e41e2c8463 100644
--- a/audio/dsoundaudio.c
+++ b/audio/dsoundaudio.c
@@ -604,7 +604,20 @@ audio_dsound_realize(AudioBackend *abe, Audiodev *dev, Error **errp)
         return false;
     }
 
-    hr = IDirectSound_Initialize (s->dsound, NULL);
+    GUID out_guid;
+    LPGUID out_dev = NULL;
+    if (dso->out && dso->out->has_dev && dso->out->dev && dso->out->dev[0] &&
+        strcmp(dso->out->dev, "default") != 0) {
+        wchar_t wguid[64];
+        size_t n = mbstowcs(wguid, dso->out->dev, 63);
+        if (n != (size_t)-1) {
+            wguid[n] = 0;
+            if (SUCCEEDED(IIDFromString(wguid, &out_guid)))
+                out_dev = &out_guid;
+        }
+    }
+
+    hr = IDirectSound_Initialize (s->dsound, out_dev);
     if (FAILED (hr)) {
         dserror_set(errp, hr, "Could not initialize DirectSound");
         return false;
@@ -622,7 +635,20 @@ audio_dsound_realize(AudioBackend *abe, Audiodev *dev, Error **errp)
         return false;
     }
 
-    hr = IDirectSoundCapture_Initialize (s->dsound_capture, NULL);
+    GUID in_guid;
+    LPGUID in_dev = NULL;
+    if (dso->in && dso->in->has_dev && dso->in->dev && dso->in->dev[0] &&
+        strcmp(dso->in->dev, "default") != 0) {
+        wchar_t wguid[64];
+        size_t n = mbstowcs(wguid, dso->in->dev, 63);
+        if (n != (size_t)-1) {
+            wguid[n] = 0;
+            if (SUCCEEDED(IIDFromString(wguid, &in_guid)))
+                in_dev = &in_guid;
+        }
+    }
+
+    hr = IDirectSoundCapture_Initialize (s->dsound_capture, in_dev);
     if (FAILED(hr)) {
         dserror_set(errp, hr, "Could not initialize DirectSoundCapture");
         return false;
diff --git a/audio/sdlaudio.c b/audio/sdlaudio.c
