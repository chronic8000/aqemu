     if (!sdl->devid) {
         return -1;
     }
@@ -401,7 +403,7 @@ static int sdl_init_in(HWVoiceIn *hw, audsettings *as)
     req.userdata = sdl;
 
     sdl->dev = dev;
-    sdl->devid = sdl_open(&req, &obt, 1);
+    sdl->devid = sdl_open(&req, &obt, 1, (spdo && spdo->has_dev) ? spdo->dev : NULL);
