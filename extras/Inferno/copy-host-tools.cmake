# Copy extras/Inferno/host-tools next to aqemu, following symlinks.
# A busy file (the tools build still writing) is skipped. Never fails the app link.
if(NOT DEFINED SRC OR NOT DEFINED DST)
	message(FATAL_ERROR "SRC and DST are required")
endif()
if(NOT EXISTS "${SRC}")
	message(STATUS "host-tools not present yet: ${SRC}")
	return()
endif()
file(MAKE_DIRECTORY "${DST}")
file(GLOB_RECURSE _items LIST_DIRECTORIES false "${SRC}/*")
foreach(_from IN LISTS _items)
	set(_real "${_from}")
	if(IS_SYMLINK "${_from}")
		file(READ_SYMLINK "${_from}" _link)
		if(NOT IS_ABSOLUTE "${_link}")
			get_filename_component(_dir "${_from}" DIRECTORY)
			get_filename_component(_real "${_dir}/${_link}" ABSOLUTE)
		else()
			set(_real "${_link}")
		endif()
	endif()
	if(NOT EXISTS "${_real}")
		continue()
	endif()
	file(RELATIVE_PATH _rel "${SRC}" "${_from}")
	set(_to "${DST}/${_rel}")
	get_filename_component(_todir "${_to}" DIRECTORY)
	file(MAKE_DIRECTORY "${_todir}")
	execute_process(
		COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_real}" "${_to}"
		RESULT_VARIABLE _rc
	)
	if(NOT _rc EQUAL 0)
		message(STATUS "skipped ${_rel}")
	endif()
endforeach()
